{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design"
      ],
      "port": 4321
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-e2e-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "env": {
        "ADMIN_EMAILS": "e2e-admin@iwc.test"
      }
    },
    {
      "name": "app-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "app",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "next",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "web-photo-store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "env": {
        "ADMIN_EMAILS": "e2e-admin@iwc.test",
        "PHOTO_STORE_S3_URL": "http://127.0.0.1:54321/storage/v1/s3/photos",
        "PHOTO_STORE_KEY_ID": "625729a08b95bf1b7ff351a663f3a23c",
        "PHOTO_STORE_SECRET": "850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907",
        "PHOTO_STORE_REGION": "local",
        "PHOTO_STORE_PUBLIC_URL": "http://127.0.0.1:54321/storage/v1/object/public/photos"
      }
    }
  ]
}
