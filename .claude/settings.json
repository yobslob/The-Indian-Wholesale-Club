{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/check.mjs)",
      "Bash(node scripts/check.mjs *)",
      "Bash(node scripts/docs-audit.mjs)",
      "Bash(node scripts/db-test.mjs)",
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:types)",
      "Bash(pnpm dev:admin *)",
      "Bash(pnpm turbo *)",
      "Bash(pnpm --filter *)",
      "Bash(npx supabase start*)",
      "Bash(npx supabase stop*)",
      "Bash(npx supabase status*)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase migration new *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(git push*)",
      "Bash(pnpm add *)",
      "Bash(pnpm --filter * add *)",
      "Bash(npx supabase link*)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(npx supabase db reset --linked*)",
      "Bash(supabase db reset --linked*)",
      "Bash(npx supabase db push*)",
      "Bash(supabase db push*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh workflow run*)"
    ]
  }
}
