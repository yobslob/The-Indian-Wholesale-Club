# -----------------------------------------------------------------------------
# The IWC app (Expo). Copy this file to `.env` and fill in the values (docs/ops.md §App).
# Only `EXPO_PUBLIC_` variables exist, and all of them end up inside the app:
# never put the Supabase service-role key or the Stripe secret key here.
# -----------------------------------------------------------------------------

# Supabase: the project URL and the public anon key.
# Local Supabase on a phone: use the computer's LAN IP instead of 127.0.0.1
# (`ipconfig` → IPv4 address; `npx supabase status` prints the local anon key).
EXPO_PUBLIC_SUPABASE_URL=http://YOUR-LAN-IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The website's server (checkout, order confirmation, guest order lookup).
# Local: `pnpm --filter web dev` (port 3000, not Expo's 8081), with the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:3000

# Stripe publishable key (pk_test_… while testing), the same account as the website.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
