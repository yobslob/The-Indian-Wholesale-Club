# -----------------------------------------------------------------------------
# Expo (React Native) — copy this file to `.env` and fill in real values.
# Only `EXPO_PUBLIC_`-prefixed variables are exposed to the app bundle.
# Never ship the Supabase service-role key in a mobile app.
# -----------------------------------------------------------------------------

# Supabase (public anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Next.js API base URL used for real checkout / order lookups.
# For a physical device, use your machine's LAN IP (e.g. http://192.168.1.10:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
