{
  "expo": {
    "name": "The Indian Wholesale Club",
    "slug": "iwc",
    "extra": {
      "eas": {
        "projectId": "a3d8cbc0-bfa4-4aa8-ad53-eea9824778f4"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "iwc",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.root.app"
    },
    "android": {
      "package": "com.root.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera photographs pieces for a new listing (admins only).",
          "photosPermission": "Photos you pick are added to a listing (admins only)."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.root.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}