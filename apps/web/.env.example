# -----------------------------------------------------------------------------
# Root web app (Next.js) — copy this file to `.env` and fill in real values.
# NEVER commit `.env`. This example file must only contain placeholders.
# -----------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection — read by scripts/apply-*.ts (keep in sync with DIRECT_URL if used)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Resend (transactional email)
RESEND_API_KEY=re_your-key
# Required in production; domain must be verified with Resend
RESEND_FROM_EMAIL=orders@your-domain.com
EMAIL_OUTBOX_CRON_SECRET=replace-with-a-random-secret
ADMIN_ALERT_WEBHOOK_URL=

# Carrier webhook HMAC secret (rejects unsigned webhooks in production)
CARRIER_WEBHOOK_SECRET=your-carrier-webhook-secret

# Comma-separated admin emails (role-based admin access)
ADMIN_EMAILS=admin@example.com

# Site URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact address (replaces the hard-coded SUPPORT_EMAIL placeholder).
# NEXT_PUBLIC_ variant is what client-rendered pages (footer, checkout success)
# display; CONTACT_EMAIL is read server-side (API routes, transactional email).
CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
