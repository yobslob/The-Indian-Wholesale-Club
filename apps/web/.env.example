# -----------------------------------------------------------------------------
# IWC web app (Next.js): copy this file to `.env` and fill in real values.
# NEVER commit `.env` / `.env.local`. This example file must only contain placeholders.
# Local Supabase: put its URL + keys (`npx supabase status`) in `.env.local`, which overrides `.env` (docs/ops.md).
# -----------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Resend (transactional email)
RESEND_API_KEY=re_your-key
# Required in production; domain must be verified with Resend
RESEND_FROM_EMAIL=orders@your-domain.com
EMAIL_OUTBOX_CRON_SECRET=replace-with-a-random-secret
ADMIN_ALERT_WEBHOOK_URL=

# Comma-separated admin emails. Admin = signed in + role admin + email here + email in admin_emails (INV-7)
ADMIN_EMAILS=admin@example.com

# Site URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Support address shown on /contact and in order emails (Q-9).
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
