# Expo SDK 52 packages (babel-preset-expo, expo-router, nativewind's Babel preset, Metro's
# asset plugin) load packages they don't declare, which pnpm's strict layout hides.
# Hoisting everything into the root node_modules makes them resolvable (engineering.md §App).
# Revisit with the Expo SDK upgrade (B-9); newer SDKs work with pnpm's isolated layout.
shamefully-hoist=true
