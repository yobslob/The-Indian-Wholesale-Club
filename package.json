{
  "name": "root",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "node scripts/check.mjs",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:test": "node scripts/db-test.mjs",
    "script:connections": "tsx scripts/test-connections.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare": "husky",
    "dev:admin": "node scripts/dev-admin.mjs",
    "dev:photos": "node scripts/dev-photos.mjs",
    "demo:photos": "node scripts/demo-photos.mjs",
    "demo:load": "node scripts/demo.mjs load",
    "demo:clear": "node scripts/demo.mjs clear",
    "dev:estimates": "node scripts/dev-estimates.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "prod:seed": "node scripts/production-seed.mjs",
    "catalogue": "node scripts/build-catalogue.mjs",
    "catalogue:apply": "node scripts/build-catalogue.mjs --apply",
    "catalogue:folders": "node scripts/build-catalogue.mjs --folders"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "resend": "^6.29.0",
    "stripe": "^22.6.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
